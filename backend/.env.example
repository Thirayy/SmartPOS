# Salin file ini menjadi backend/.env lalu sesuaikan nilainya.
# Jangan pernah commit file .env yang berisi kredensial asli.

PROJECT_NAME=SmartPOS
DATABASE_URL=postgresql://postgres:admin123@localhost:5432/smartpos_db
# Wajib minimal 32 karakter. Buat nilai acak, contoh:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=ganti-dengan-secret-key-acak-minimal-32-karakter
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=["http://localhost:3000"]
# Zona waktu untuk batas tanggal laporan, mis. Asia/Jakarta.
APP_TIMEZONE=Asia/Jakarta

# Opsional. Analisis AI tidak aktif jika AI_API_KEY kosong.
AI_API_KEY=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
AI_BASE_URL=https://openrouter.ai/api/v1/chat/completions
AI_MODEL=deepseek/deepseek-chat
